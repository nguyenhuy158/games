{
  "name": "games",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-assets.mjs",
    "check": "biome lint .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "node tests/unit/logic.test.mjs",
    "test:coverage": "node tests/coverage.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:video": "E2E_VIDEO_DIR=e2e-videos node tests/e2e/run.mjs --undercover-round-video",
    "e2e:video:soi": "E2E_VIDEO_DIR=e2e-videos node tests/e2e/run.mjs --soi-round-video",
    "e2e:prod": "E2E_BASE_URL=https://games.huyab.cfd node tests/e2e/readonly-smoke.mjs && E2E_BASE_URL=https://games.huyab.cfd node tests/e2e/layout-check.mjs",
    "deploy": "pnpm test && wrangler deploy",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@babel/plugin-syntax-decorators": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@huyab/config": "github:nguyenhuy158/kit#v0.5.0&path:packages/config",
    "@huyab/e2e": "github:nguyenhuy158/kit#v0.5.0&path:packages/e2e",
    "@istanbuljs/esm-loader-hook": "^0.3.0",
    "acorn": "^8.19.0",
    "babel-plugin-istanbul": "7.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "lucide": "0.468.0",
    "nyc": "^18.0.0",
    "playwright-core": "^1.63.0",
    "wrangler": "^4.106.0"
  },
  "dependencies": {
    "@huyab/sso": "github:nguyenhuy158/kit#v0.5.0&path:packages/sso"
  }
}
